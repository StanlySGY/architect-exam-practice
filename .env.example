# OpenAI-compatible model endpoint. Examples:
# DeepSeek: https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama: http://127.0.0.1:11434/v1
ARCHITECT_LLM_BASE_URL=https://api.deepseek.com/v1
ARCHITECT_LLM_API_KEY=replace-with-your-key
ARCHITECT_LLM_MODEL=deepseek-chat
# 可选：界面模型下拉框可展示的完整列表（逗号分隔），未配置时只展示 ARCHITECT_LLM_MODEL。
# ARCHITECT_LLM_MODELS=deepseek-chat,deepseek-reasoner
# 可选：开启流式响应，慢模型可避免代理网关在固定窗口内无响应就掐断长生成。
# ARCHITECT_LLM_STREAM=true
# 每日目标与连续打卡按该时区的自然日统计，默认 Asia/Shanghai。
# ARCHITECT_STUDY_TIME_ZONE=Asia/Shanghai

# Optional runtime settings
# ARCHITECT_AGENT_TIMEOUT_MS=600000
# 非回环监听时必填；请使用至少 32 个随机字符。Agent HTTP 执行默认关闭。
# ARCHITECT_ACCESS_TOKEN=replace-with-a-long-random-token
# ARCHITECT_ENABLE_AGENTS=false
# ARCHITECT_MINDMAP=architect.mm
# ARCHITECT_DATA_FILE=data/state.sqlite
# 允许 fetch-models 访问的私有模型主机，默认不允许私网/回环地址。
# ARCHITECT_LLM_ALLOWED_HOSTS=127.0.0.1,localhost
# Claude CLI 路径只从启动环境读取，不能通过网页配置修改。
# ARCHITECT_CLAUDE_COMMAND=claude
# 真题库默认读取相邻仓库；仅本机练习，不要公开发布题库内容
# ARCHITECT_BANK_FILE=../architect-exam-bank/data/bank.json
