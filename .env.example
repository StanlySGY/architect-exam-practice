# OpenAI-compatible model endpoint. Examples:
# DeepSeek: https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama: http://127.0.0.1:11434/v1
RUANKAO_LLM_BASE_URL=https://api.deepseek.com/v1
RUANKAO_LLM_API_KEY=replace-with-your-key
RUANKAO_LLM_MODEL=deepseek-chat

# Optional runtime settings
# RUANKAO_AGENT_TIMEOUT_MS=600000
# RUANKAO_MINDMAP=ruankao.mm
# RUANKAO_DATA_FILE=data/state.sqlite
# 真题库默认读取相邻仓库；仅本机练习，不要公开发布题库内容
# RUANKAO_BANK_FILE=../ruankao-architect-practice/data/bank.json
