{
  "name": "architect-chapter-practice",
  "version": "1.0.0",
  "private": true,
  "description": "系统架构设计师章节练习、判卷与错题回顾微服务",
  "type": "module",
  "scripts": {
    "start": "NODE_USE_ENV_PROXY=1 node server.mjs",
    "dev": "NODE_USE_ENV_PROXY=1 node --watch server.mjs",
    "test": "node --test",
    "audit:bank-traceability": "node scripts/audit-bank-traceability.mjs",
    "lint": "find server.mjs src test scripts public -type f \\( -name '*.mjs' -o -name '*.js' \\) -print0 | xargs -0 -n1 node --check",
    "audit:learning-content": "node scripts/audit-learning-content.mjs",
    "audit:verification-queue": "node scripts/audit-learning-verification-queue.mjs",
    "audit:answer-risk": "node scripts/audit-bank-answer-risk.mjs"
  },
  "engines": {
    "node": ">=22.15"
  }
}
